<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="10.0" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.edziennikui.teacher.TeacherAttendanceController">
    <children>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="1. Rozpocznij Lekcję">
                    <content>
                        <VBox spacing="20.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label text="Konfiguracja nowej lekcji" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                                <GridPane hgap="15.0" vgap="15.0">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="100.0" prefWidth="120.0" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="Klasa:" GridPane.rowIndex="0" />
                                        <ComboBox fx:id="comboClass" prefWidth="250.0" promptText="Wybierz klasę..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label text="Przedmiot:" GridPane.rowIndex="1" />
                                        <ComboBox fx:id="comboSubject" prefWidth="250.0" promptText="Wybierz przedmiot..." GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Temat lekcji:" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtTopic" promptText="Wpisz temat zajęć..." GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    </children>
                                </GridPane>

                                <Separator />

                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                    <children>
                                        <Button onAction="#handleCreateLesson" prefHeight="45.0" prefWidth="200.0"
                                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"
                                                text="Utwórz i przejdź do listy" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <Tab fx:id="tabAttendance" text="2. Lista obecności" disable="true">
                    <content>
                        <VBox spacing="15.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <Label fx:id="lblActiveLessonInfo" text="Lekcja: Matematyka - Temat: ..." style="-fx-font-weight: bold;" />
                                            <Label fx:id="lblActiveClassName" text="Klasa: 1A" />
                                        </VBox>
                                    </children>
                                </HBox>

                                <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colStudentName" prefWidth="300.0" text="Imię i Nazwisko" />
                                        <TableColumn fx:id="colStatus" prefWidth="250.0" text="Status obecności" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#handleSaveAttendance" prefHeight="40.0" prefWidth="180.0"
                                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"
                                                text="Zatwierdź obecność" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>