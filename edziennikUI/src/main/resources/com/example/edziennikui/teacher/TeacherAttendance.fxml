<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TextField?>
<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.edziennikui.teacher.TeacherAttendanceController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f4f4f4; -fx-background-radius: 10;">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Wybierz klasę:" />
                        <ComboBox fx:id="comboClass" prefWidth="150.0" promptText="Klasa..." />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Przedmiot:" />
                        <ComboBox fx:id="comboSubject" prefWidth="200.0" promptText="Przedmiot..." />
                    </children>
                </VBox>
                <VBox alignment="BOTTOM_LEFT" HBox.hgrow="ALWAYS">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleLoadList" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Załaduj listę" />
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
        </HBox>

        <VBox spacing="5.0">
            <children>
                <Label text="Temat lekcji:" />
                <TextField fx:id="txtTopic" promptText="Wpisz temat zajęć..." />
            </children>
        </VBox>

        <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colStudentName" prefWidth="300.0" text="Imię i Nazwisko" />
                <TableColumn fx:id="colStatus" prefWidth="250.0" text="Status obecności" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleSaveAttendance" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Zapisz listę" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
</VBox>