<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="850.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.edziennikui.shared.ScheduleController">
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox>
                    <children>
                        <Label text="Mój Plan Lekcji">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label textFill="#7f8c8d" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <TableView fx:id="scheduleTable" VBox.vgrow="ALWAYS" style="-fx-selection-bar: #ecf0f1; -fx-selection-bar-non-focused: #ecf0f1;">
            <columns>
                <TableColumn fx:id="colTime" text="Godzina" />
                <TableColumn fx:id="colMonday" text="Poniedziałek" />
                <TableColumn fx:id="colTuesday" text="Wtorek" />
                <TableColumn fx:id="colWednesday" text="Środa" />
                <TableColumn fx:id="colThursday" text="Czwartek" />
                <TableColumn fx:id="colFriday" text="Piątek" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
</VBox>