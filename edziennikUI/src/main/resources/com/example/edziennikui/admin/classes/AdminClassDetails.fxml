<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.edziennikui.admin.classes.AdminClassDetailsController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblClassName" text="Klasa: [Nazwa Klasy]">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblTutor" text="Wychowawca: [Imię i Nazwisko]" textFill="#7f8c8d" />
                    </children>
                </VBox>
                <Button mnemonicParsing="false" onAction="#handleBack" text="← Powrót do listy klas" />
            </children>
        </HBox>

        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Lista uczniów:">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" minWidth="80.0" maxWidth="80.0" text="ID" />
                        <TableColumn fx:id="colFirstName" text="Imię" />
                        <TableColumn fx:id="colLastName" text="Nazwisko" />
                        <TableColumn fx:id="colEmail" text="Email" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <HBox spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleAddStudentToClass" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Dodaj ucznia do klasy" />
                <Button mnemonicParsing="false" onAction="#handleRemoveStudentFromClass" style="-fx-background-color: #c0392b; -fx-text-fill: white;" text="Usuń zaznaczonego ucznia" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
</VBox>