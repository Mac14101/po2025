<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.edziennikui.admin.AdminUsersController">
    <children>
        <Label text="Zarządzanie Użytkownikami" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <HBox spacing="10.0">
            <children>
                <Button text="Dodaj użytkownika" style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
                <Button text="Odśwież" />
            </children>
        </HBox>

        <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn prefWidth="50.0" text="ID" />
                <TableColumn prefWidth="150.0" text="Imię" />
                <TableColumn prefWidth="150.0" text="Nazwisko" />
                <TableColumn prefWidth="150.0" text="Rola" />
                <TableColumn prefWidth="200.0" text="Email" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>