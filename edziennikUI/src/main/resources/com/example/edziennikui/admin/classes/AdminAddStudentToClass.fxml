<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" prefWidth="500.0" prefHeight="400.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.edziennikui.admin.classes.AdminAddStudentToClassController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Wybierz ucznia do dodania" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="availableStudentsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFirstName" text="Imię" />
            <TableColumn fx:id="colLastName" text="Nazwisko" />
            <TableColumn fx:id="colEmail" text="Email" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Anuluj" onAction="#handleCancel"/>
        <Button text="Dodaj do klasy" onAction="#handleAdd" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
    </HBox>
</VBox>