<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.edziennikui.admin.schedule.AdminScheduleManageController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Zarządzanie Planem Lekcji">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <Label text="Filtruj wg klasy:" />
                <ComboBox fx:id="comboFilterClass" prefWidth="150.0" promptText="Wybierz klasę..." />
            </children>
        </HBox>

        <TableView fx:id="scheduleTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDay" prefWidth="120.0" text="Dzień" />
                <TableColumn fx:id="colTime" prefWidth="100.0" text="Godzina" />
                <TableColumn fx:id="colSubject" prefWidth="150.0" text="Przedmiot" />
                <TableColumn fx:id="colTeacher" prefWidth="200.0" text="Nauczyciel" />
                <TableColumn fx:id="colRoom" prefWidth="100.0" text="Sala" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleAddLesson" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Dodaj nową lekcję" />
                <Button mnemonicParsing="false" onAction="#handleEditLesson" text="Edytuj zaznaczoną" />
                <Button mnemonicParsing="false" onAction="#handleDeleteLesson" style="-fx-background-color: #c0392b; -fx-text-fill: white;" text="Usuń z planu" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
</VBox>