<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.edziennikui.admin.classes.AdminClassListController">
    <children>
        <Label text="Zarządzanie Klasami">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <TableView fx:id="classTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" minWidth="80.0" maxWidth="80.0" text="ID" />
                <TableColumn fx:id="colClassName" text="Nazwa Klasy" />
                <TableColumn fx:id="colStudentCount" text="Liczba Uczniów" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleShowDetails" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Pokaż szczegóły klasy" />
                <Button mnemonicParsing="false" onAction="#handleAddClass" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Dodaj nową klasę" />
                <Button mnemonicParsing="false" onAction="#handleDeleteClass" style="-fx-background-color: #c0392b; -fx-text-fill: white;" text="Usuń klasę" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
</VBox>