<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.gui.SamochoGUIControler">
    <left>
        <VBox prefWidth="240.0" BorderPane.alignment="CENTER">
            <children>
                <TitledPane animated="true" text="Samochód">
                    <content>
                        <FlowPane prefHeight="200.0" prefWidth="200.0">
                            <children>
                                <Label text="Nazwa"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label text="Nr rejestracyjny"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label text="Waga"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label text="Prędkość"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Button mnemonicParsing="false" text="Włącz" fx:id="startButton"
                                        onAction="#onStartButton">
                                    <FlowPane.margin>
                                        <Insets bottom="3.0" left="5.0" right="5.0" top="3.0"/>
                                    </FlowPane.margin>
                                </Button>
                                <Button mnemonicParsing="false" text="Wyłącz" fx:id="stopButton"
                                        onAction="#onStopButton">
                                    <FlowPane.margin>
                                        <Insets bottom="3.0" left="5.0" right="5.0" top="3.0"/>
                                    </FlowPane.margin>
                                </Button>
                                <Button mnemonicParsing="false" text="Button" fx:id="buttonButton"
                                        onAction="#onButtonButton">
                                    <FlowPane.margin>
                                        <Insets bottom="3.0" left="5.0" right="5.0" top="3.0"/>
                                    </FlowPane.margin>
                                </Button>
                            </children>
                        </FlowPane>
                    </content>
                </TitledPane>
                <TitledPane animated="true" text="Skrzynia Biegów">
                    <content>
                        <FlowPane prefHeight="200.0" prefWidth="200.0">
                            <children>
                                <Label text="Nazwa"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label text="Cena"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label text="Waga"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label text="Bieg"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Button mnemonicParsing="false" text="Zwiększ bieg" fx:id="upshiftGearButton"
                                        onAction="#onUpshiftGearButton">
                                    <FlowPane.margin>
                                        <Insets bottom="3.0" left="5.0" right="5.0" top="3.0"/>
                                    </FlowPane.margin>
                                </Button>
                                <Button mnemonicParsing="false" text="Zmniejsz bieg" fx:id="downshiftGearButton"
                                        onAction="#onDownshiftGearButton">
                                    <FlowPane.margin>
                                        <Insets bottom="3.0" left="5.0" right="5.0" top="3.0"/>
                                    </FlowPane.margin>
                                </Button>
                            </children>
                        </FlowPane>
                    </content>
                </TitledPane>
                <TitledPane animated="true" text="Silnik">
                    <content>
                        <FlowPane prefHeight="200.0" prefWidth="200.0">
                            <children>
                                <Label text="Nazwa"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label text="Cena"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label text="Waga"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label text="Obroty"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Button mnemonicParsing="false" text="Dodaj gazu" fx:id="">
                                    <FlowPane.margin>
                                        <Insets bottom="3.0" left="5.0" right="5.0" top="3.0"/>
                                    </FlowPane.margin>
                                </Button>
                                <Button mnemonicParsing="false" text="Ujmij gazu" fx:id="">
                                    <FlowPane.margin>
                                        <Insets bottom="3.0" left="5.0" right="5.0" top="3.0"/>
                                    </FlowPane.margin>
                                </Button>
                            </children>
                        </FlowPane>
                    </content>
                </TitledPane>
                <TitledPane animated="true" text="Sprzęgło">
                    <content>
                        <FlowPane prefHeight="200.0" prefWidth="200.0">
                            <children>
                                <Label text="Nazwa"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label text="Cena"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label text="Waga"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label text="Stan"/>
                                <TextField prefWidth="220.0">
                                    <FlowPane.margin>
                                        <Insets/>
                                    </FlowPane.margin>
                                </TextField>
                                <Button mnemonicParsing="false" text="Naciśnij" fx:id="pushClutchButton"
                                        onAction="#onPushClutchButton">
                                    <FlowPane.margin>
                                        <Insets bottom="3.0" left="5.0" right="5.0" top="3.0"/>
                                    </FlowPane.margin>
                                </Button>
                                <Button mnemonicParsing="false" text="Zwolnij" fx:id="releaseClutchButton"
                                        onAction="#onReleaseClutchButton">
                                    <FlowPane.margin>
                                        <Insets bottom="3.0" left="5.0" right="5.0" top="3.0"/>
                                    </FlowPane.margin>
                                </Button>
                            </children>
                        </FlowPane>
                    </content>
                </TitledPane>
            </children>
        </VBox>
    </left>
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Close"/>
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Edit">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Delete"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" style="-fx-background-color: #66ff66;" BorderPane.alignment="CENTER">
            <children>
                <FlowPane alignment="TOP_CENTER" columnHalignment="CENTER" prefHeight="200.0" prefWidth="200.0">
                    <children>
                        <Label text="Samochód : "/>
                        <ChoiceBox prefWidth="150.0"/>
                        <Button mnemonicParsing="false" text="Dodaj nowy"/>
                        <Button mnemonicParsing="false" text="Usuń"/>
                    </children>
                </FlowPane>
            </children>
        </VBox>
    </center>
</BorderPane>
