<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
            minWidth="-Infinity"
            prefWidth="600" styleClass="default-size" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17.0.12" fx:controller="gui.gui.SamochoGUIControler">
    <left>
        <VBox styleClass="menu-vbox" BorderPane.alignment="CENTER">
            <children>
                <TitledPane animated="true" styleClass="menu-titled-pane" text="Samochód" VBox.vgrow="NEVER">
                    <content>
                        <FlowPane styleClass="menu-titled-pane-element">
                            <children>
                                <Label styleClass="menu-titled-pane-label" text="Model"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="carModelTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label styleClass="menu-titled-pane-label" text="Nr rejestracyjny"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="carRegisterNumberTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label styleClass="menu-titled-pane-label" text="Waga"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="carWeightTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label styleClass="menu-titled-pane-label" text="Prędkość"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="carSpeedTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Button fx:id="startButton" mnemonicParsing="false" onAction="#onStartButton"
                                        styleClass="menu-titled-pane-button" text="Włącz">
                                    <FlowPane.margin>
                                        <Insets left="10.0" right="10.0"/>
                                    </FlowPane.margin>
                                </Button>
                                <Button fx:id="stopButton" mnemonicParsing="false" onAction="#onStopButton"
                                        styleClass="menu-titled-pane-button" text="Wyłącz">
                                    <FlowPane.margin>
                                        <Insets left="10.0" right="10.0"/>
                                    </FlowPane.margin>
                                </Button>
                            </children>
                        </FlowPane>
                    </content>
                </TitledPane>
                <TitledPane animated="true" styleClass="menu-titled-pane" text="Skrzynia Biegów">
                    <content>
                        <FlowPane styleClass="menu-titled-pane-element">
                            <children>
                                <Label styleClass="menu-titled-pane-label" text="Nazwa"/>
                                <TextField editable="false" prefWidth="220.0" styleClass="menu-titled-pane-textField"
                                           fx:id="gearboxNameTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label styleClass="menu-titled-pane-label" text="Cena"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="gearboxPriceTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label styleClass="menu-titled-pane-label" text="Waga"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="gearboxWeightTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label styleClass="menu-titled-pane-label" text="Bieg"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="gearboxGearTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Button fx:id="upshiftGearButton" mnemonicParsing="false"
                                        onAction="#onUpshiftGearButton" styleClass="menu-titled-pane-button-long"
                                        text="Zwiększ bieg">
                                    <FlowPane.margin>
                                        <Insets left="10.0" right="10.0"/>
                                    </FlowPane.margin>
                                </Button>
                                <Button fx:id="downshiftGearButton" mnemonicParsing="false"
                                        onAction="#onDownshiftGearButton" styleClass="menu-titled-pane-button-long"
                                        text="Zmniejsz bieg">
                                    <FlowPane.margin>
                                        <Insets left="10.0" right="10.0"/>
                                    </FlowPane.margin>
                                </Button>
                            </children>
                        </FlowPane>
                    </content>
                </TitledPane>
                <TitledPane animated="true" styleClass="menu-titled-pane" text="Silnik">
                    <content>
                        <FlowPane styleClass="menu-titled-pane-element">
                            <children>
                                <Label styleClass="menu-titled-pane-label" text="Nazwa"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="engineNameTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label styleClass="menu-titled-pane-label" text="Cena"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="enginePriceTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label styleClass="menu-titled-pane-label" text="Waga"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="engineWeightTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label styleClass="menu-titled-pane-label" text="Obroty"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="engineRPMTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Button fx:id="pushGasButton" mnemonicParsing="false" onAction="#onPushGasButton"
                                        styleClass="menu-titled-pane-button" text="Dodaj gazu">
                                    <FlowPane.margin>
                                        <Insets left="10.0" right="10.0"/>
                                    </FlowPane.margin>
                                </Button>
                                <Button fx:id="releaseGasButton" mnemonicParsing="false" onAction="#onReleaseGasButton"
                                        styleClass="menu-titled-pane-button" text="Ujmij gazu">
                                    <FlowPane.margin>
                                        <Insets left="10.0" right="10.0"/>
                                    </FlowPane.margin>
                                </Button>
                            </children>
                        </FlowPane>
                    </content>
                </TitledPane>
                <TitledPane animated="true" styleClass="menu-titled-pane" text="Sprzęgło">
                    <content>
                        <FlowPane prefHeight="200.0" styleClass="menu-titled-pane-element">
                            <children>
                                <Label styleClass="menu-titled-pane-label" text="Nazwa"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="clutchNameTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label styleClass="menu-titled-pane-label" text="Cena"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="clutchPriceTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label styleClass="menu-titled-pane-label" text="Waga"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="clutchWeightTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Label styleClass="menu-titled-pane-label" text="Stan"/>
                                <TextField editable="false" styleClass="menu-titled-pane-textField"
                                           fx:id="clutchStatusTextField">
                                    <FlowPane.margin>
                                        <Insets bottom="5.0" top="5.0"/>
                                    </FlowPane.margin>
                                </TextField>
                                <Button fx:id="pushClutchButton" mnemonicParsing="false" onAction="#onPushClutchButton"
                                        styleClass="menu-titled-pane-button" text="Naciśnij">
                                    <FlowPane.margin>
                                        <Insets left="10.0" right="10.0"/>
                                    </FlowPane.margin>
                                </Button>
                                <Button fx:id="releaseClutchButton" mnemonicParsing="false"
                                        onAction="#onReleaseClutchButton" styleClass="menu-titled-pane-button"
                                        text="Zwolnij">
                                    <FlowPane.margin>
                                        <Insets left="10.0" right="10.0"/>
                                    </FlowPane.margin>
                                </Button>
                            </children>
                        </FlowPane>
                    </content>
                </TitledPane>
            </children>
        </VBox>
    </left>
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Close"/>
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Edit">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Delete"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" style="-fx-background-color: #66ff66;" BorderPane.alignment="CENTER"
              fx:id="map">
            <children>
                <FlowPane alignment="TOP_CENTER" columnHalignment="CENTER" prefHeight="200.0" prefWidth="200.0">
                    <children>
                        <Label text="Samochód : "/>
                        <ComboBox fx:id="selectCarComboBox" prefWidth="150.0"/>
                        <Button mnemonicParsing="false" text="Dodaj nowy" fx:id="newCarButton"
                                onAction="#onNewCarButton"/>
                        <Button mnemonicParsing="false" text="Usuń"/>
                    </children>
                </FlowPane>
            </children>
        </VBox>
    </center>
</BorderPane>
