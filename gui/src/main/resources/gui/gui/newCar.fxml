<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="480.0" prefWidth="600" stylesheets="@newCar.css"
      xmlns="http://javafx.com/javafx/17.0.12" fx:controller="gui.gui.AddCarController">
    <children>
        <FlowPane styleClass="container-full">
            <children>
                <Label text="Tworzenie nowego samochodu"/>
            </children>
            <styleClass>
                <String fx:value="container-full"/>
                <String fx:value="header"/>
            </styleClass>
        </FlowPane>
        <FlowPane prefHeight="50.0" prefWidth="0.0" style="-fx-alignment: center;">
            <children>
                <ComboBox prefHeight="40.0" prefWidth="250.0" fx:id="modelComboBox" onAction="#onModelComboBox"/>
            </children>
            <VBox.margin>
                <Insets bottom="10.0" top="10.0"/>
            </VBox.margin>
        </FlowPane>
        <SplitPane dividerPositions="0.5" styleClass="container-full">
            <items>
                <AnchorPane>
                    <children>
                        <FlowPane styleClass="container-half">
                            <children>
                                <Label styleClass="header-section" text="Samochód"/>
                                <Label styleClass="label-section" text="Model"/>
                                <TextField fx:id="carModelTextField" styleClass="textField-section"/>
                                <Label styleClass="label-section" text="Nr rejestracyjny"/>
                                <TextField fx:id="carNumberTextField" styleClass="textField-section"/>
                                <Label layoutX="10.0" layoutY="66.0" styleClass="label-section" text="Waga"/>
                                <TextField fx:id="carWeightTextField" layoutX="106.0" layoutY="62.0"
                                           styleClass="textField-section"/>
                                <Button fx:id="carNumberGenerateButton" mnemonicParsing="false"
                                        onAction="#onCarNumberGenerateButton" text="Wygeneruj">
                                    <FlowPane.margin>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                                    </FlowPane.margin>
                                </Button>
                            </children>
                        </FlowPane>
                    </children>
                </AnchorPane>
                <AnchorPane>
                    <children>
                        <FlowPane styleClass="container-half">
                            <children>
                                <Label styleClass="header-section" text="Silnik"/>
                                <Label styleClass="label-section" text="Nazwa"/>
                                <TextField fx:id="engineNameTextField" styleClass="textField-section"/>
                                <Label styleClass="label-section" text="Waga"/>
                                <TextField fx:id="engineWeightTextField" styleClass="textField-section"/>
                                <Label styleClass="label-section" text="Cena"/>
                                <TextField fx:id="enginePriceTextField" styleClass="textField-section"/>
                                <Label styleClass="label-section" text="Maksymalne obroty"/>
                                <TextField fx:id="engineMaxRPMTextField" styleClass="textField-section"/>
                            </children>
                        </FlowPane>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
        <SplitPane dividerPositions="0.5" styleClass="container-full">
            <items>
                <AnchorPane>
                    <children>
                        <FlowPane styleClass="container-half">
                            <children>
                                <Label styleClass="header-section" text="Skrzynia biegów"/>
                                <Label styleClass="label-section" text="Nazwa"/>
                                <TextField fx:id="gearboxNameTextField" styleClass="textField-section"/>
                                <Label styleClass="label-section" text="Waga"/>
                                <TextField fx:id="gearboxWeightTextField" styleClass="textField-section"/>
                                <Label styleClass="label-section" text="Cena"/>
                                <TextField fx:id="gearboxPriceTextField" styleClass="textField-section"/>
                                <Label styleClass="label-section" text="Maksymalny bieg"/>
                                <TextField fx:id="gearboxMaxGearTextField" styleClass="textField-section"/>
                            </children>
                        </FlowPane>
                    </children>
                </AnchorPane>
                <AnchorPane>
                    <children>
                        <FlowPane styleClass="container-half">
                            <children>
                                <Label styleClass="header-section" text="Sprzęgło"/>
                                <Label styleClass="label-section" text="Nazwa"/>
                                <TextField fx:id="clutchNameTextField" styleClass="textField-section"/>
                                <Label styleClass="label-section" text="Waga"/>
                                <TextField fx:id="clutchWeightTextField" styleClass="textField-section"/>
                                <Label styleClass="label-section" text="Cena"/>
                                <TextField fx:id="clutchPriceTextField" styleClass="textField-section"/>
                            </children>
                        </FlowPane>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
        <FlowPane>
            <children>
                <Button mnemonicParsing="false" fx:id="submitButton" onAction="#onSubmitButton"
                        styleClass="button-footer" text="Zatwierdź">
                    <FlowPane.margin>
                        <Insets left="30.0" right="30.0"/>
                    </FlowPane.margin>
                </Button>
                <Button mnemonicParsing="false" fx:id="cancelButton" onAction="#onCancelButton"
                        styleClass="button-footer" text="Anuluj">
                    <FlowPane.margin>
                        <Insets left="30.0" right="30.0"/>
                    </FlowPane.margin>
                </Button>
            </children>
            <styleClass>
                <String fx:value="container-full"/>
                <String fx:value="align-center"/>
                <String fx:value="footer"/>
            </styleClass>
        </FlowPane>
    </children>
</VBox>
